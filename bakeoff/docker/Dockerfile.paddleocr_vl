# PaddleOCR-VL image. PaddlePaddle stack (not transformers). paddlepaddle-gpu
# comes from Paddle's CUDA index; PaddleOCR-VL weights download on first run.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/hf_cache

# libgl1/libglib for opencv (PaddleOCR dependency).
# VM has port 80 blocked: use HTTPS apt mirrors, and drop NVIDIA's CUDA apt repos
# (unused — torch comes via pip — and they'd add failing network calls).
RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list && \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY bakeoff/envs/requirements-paddleocr_vl.txt /tmp/req.txt
# Paddle ships cu118 / cu123 / cu126 (no cu121). cu118 is the most broadly
# compatible (driver >= CUDA 11.8); the wheel bundles its own CUDA runtime, so it
# need not match the base image. Switch to cu123/cu126 if the VM needs newer.
# paddlepaddle must match paddleocr (VL-1.6 needs fused_rms_norm_ext, a newer op);
# 3.0.0 is too old. VERIFY-ON-VM: pin the exact compatible version once confirmed.
RUN pip3 install --no-cache-dir "paddlepaddle-gpu>=3.2.0" \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ && \
    pip3 install --no-cache-dir -r /tmp/req.txt

COPY bakeoff /app/bakeoff

ENTRYPOINT ["python3", "/app/bakeoff/run.py"]
CMD ["--model", "paddleocr_vl"]
