# MinerU 2.5 image. Weights download on first run into the mounted HF cache.
# MinerU controls its own torch/transformers via the [core] extra.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/hf_cache

# libgl1/libglib for opencv, which MinerU pulls in.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY bakeoff/envs/requirements-mineru.txt /tmp/req.txt
RUN pip3 install --no-cache-dir -r /tmp/req.txt

COPY bakeoff /app/bakeoff

ENTRYPOINT ["python3", "/app/bakeoff/run.py"]
CMD ["--model", "mineru"]
