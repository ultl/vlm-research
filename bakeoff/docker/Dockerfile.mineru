# MinerU 2.5 image. Weights download on first run into the mounted HF cache.
# MinerU controls its own torch/transformers via the [core] extra.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/hf_cache

# libgl1/libglib for opencv, which MinerU pulls in.
# VM has port 80 blocked: use HTTPS apt mirrors, and drop NVIDIA's CUDA apt repos
# (unused — torch comes via pip — and they'd add failing network calls).
RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list && \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY bakeoff/envs/requirements-mineru.txt /tmp/req.txt
RUN pip3 install --no-cache-dir -r /tmp/req.txt

COPY bakeoff /app/bakeoff

ENTRYPOINT ["python3", "/app/bakeoff/run.py"]
CMD ["--model", "mineru"]
