# DeepSeek-OCR image. Pins torch 2.6 + transformers 4.46 (its own stack).
# Weights pulled from HF into the mounted cache. flash-attn left optional
# (eager attention by default); add it on the VM for a speedup if desired.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/hf_cache

# VM has port 80 blocked: use HTTPS apt mirrors, and drop NVIDIA's CUDA apt repos
# (unused — torch comes via pip — and they'd add failing network calls).
RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list && \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY bakeoff/envs/requirements-deepseek_ocr.txt /tmp/req.txt
RUN pip3 install --no-cache-dir torch==2.6.0 \
        --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir -r /tmp/req.txt

COPY bakeoff /app/bakeoff

ENTRYPOINT ["python3", "/app/bakeoff/run.py"]
CMD ["--model", "deepseek_ocr"]
