# Qwen2.5-VL inference image. Weights are NOT baked in — pulled from HF into a
# mounted cache (HF_HOME) at runtime. Pin the base by digest on the VM for full
# reproducibility (see README); tag-pinned here for readability.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/hf_cache

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY bakeoff/envs/requirements-qwen25vl.txt /tmp/req.txt
RUN pip3 install --no-cache-dir torch==2.5.1 \
        --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir -r /tmp/req.txt

COPY bakeoff /app/bakeoff

ENTRYPOINT ["python3", "/app/bakeoff/run.py"]
CMD ["--model", "qwen25vl"]
